SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-publishable-or-anon-key
OPENAI_API_KEY=replace-with-server-only-openai-api-key

# Google OAuth credentials live in Supabase Auth and Google Cloud, not in this app.
# Set true only after provider + redirect allowlist configuration is verified.
CARESLINK_GOOGLE_OAUTH_ENABLED=false

# Required for persistent, abuse-controlled NDIS Case Note Companion use.
NDIS_CASE_NOTE_FINGERPRINT_PEPPER=replace-with-a-random-server-only-pepper

# Optional model and quota overrides.
OPENAI_NDIS_CASE_NOTE_MODEL=gpt-5.4-mini
NDIS_CASE_NOTE_AUTH_DAILY_LIMIT=3
NDIS_CASE_NOTE_AUTH_IP_DAILY_LIMIT=20

# Optional companion table overrides. Defaults match the migration.
SUPABASE_NDIS_CASE_NOTE_CLAIMS_TABLE=ndis_case_note_companion_claims
SUPABASE_TEMPLATE_COMPANION_EVENTS_TABLE=template_companion_events
SUPABASE_GENERATED_MATERIAL_DRAFTS_TABLE=generated_material_drafts

# Never enable this for production or release-candidate preview environments.
CARESLINK_ALLOW_COMPANION_MEMORY_STORE=false

# Optional: override the default provider draft table name.
SUPABASE_PROVIDER_DRAFTS_TABLE=provider_drafts

# Optional: override the default access-control table names.
SUPABASE_ACCESS_REQUESTS_TABLE=access_requests
SUPABASE_ACCESS_CODES_TABLE=access_codes
SUPABASE_AI_USAGE_EVENTS_TABLE=ai_usage_events

# Optional local/demo preview switch. Keep false in production.
CARESLINK_ENABLE_DEMO_AUTH=false

# Provider-only Communication Note input and browser privacy preflight UI.
# This exposes no generation API, model call, storage, Points or export action.
CARESLINK_COMMUNICATION_NOTE_COMPOSER_ENABLED=false

# Reserved M1x server boundary. The compile-time readiness latch, formal strict
# principal resolver and formal submission port remain closed, so this value
# alone cannot authenticate, enqueue or generate.
CARESLINK_COMMUNICATION_NOTE_GENERATION_API_ENABLED=false

# Reserved source-only principal composition. Keep false/blank: the formal
# composition, principal resolver and submitter are absent and READY is false.
# A future reviewed Preview would additionally require exact platform-provided
# Vercel identity, matching canonical Supabase URLs/publishable keys and this
# dedicated server-only sb_secret_ key. It never falls back to a generic key,
# but is still service-role-equivalent and bypasses RLS; it is not least privilege.
CARESLINK_COMMUNICATION_NOTE_PRINCIPAL_COMPOSITION_ENABLED=false
CARESLINK_COMMUNICATION_NOTE_PRINCIPAL_EXPECTED_SUPABASE_REF=
CARESLINK_COMMUNICATION_NOTE_PRINCIPAL_EXPECTED_VERCEL_PROJECT_ID=
CARESLINK_COMMUNICATION_NOTE_SESSION_STATUS_PREVIEW_SECRET_KEY=

# V1 Product API is Preview-only and default-off. Set both flags to exact true
# only for an approved disposable Preview gate. The expected ref must exactly
# match that Preview Supabase URL ref and must never identify Production.
CARESLINK_V1_PRODUCT_API_ENABLED=false
CARESLINK_V1_PRODUCT_API_DURABLE_ADAPTER_ENABLED=false
CARESLINK_V1_PRODUCT_API_EXPECTED_SUPABASE_REF=
CARESLINK_V1_PRODUCT_API_M0_READ_ENABLED=false
CARESLINK_V1_PRODUCT_API_DOCUMENT_DETAIL_ENABLED=false
CARESLINK_V1_PRODUCT_API_PRIVACY_REVIEW_ENABLED=false
CARESLINK_V1_PRODUCT_API_DOCUMENT_WRITE_ENABLED=false

# Portal Referral operations remain disabled by default. Base and per-operation
# boolean gates must stay false/unset and the expected ref empty until a fresh
# disposable Preview passes identity, RLS, replay and transaction assertions.
# The request-scoped durable adapter cannot bypass these gates.
CARESLINK_PORTAL_REFERRAL_API_ENABLED=false
CARESLINK_PORTAL_REFERRAL_DURABLE_ADAPTER_ENABLED=false
CARESLINK_PORTAL_REFERRAL_INTAKE_ENABLED=false
CARESLINK_PORTAL_REFERRAL_SOURCE_DETAIL_ENABLED=false
# Assignment M1a shares /referrals with source-role pages. Its page latch stays
# closed if either source-role UI gate above is true; request-scoped API
# authorization remains independent.
CARESLINK_PORTAL_REFERRAL_ASSIGNMENT_ENABLED=false
# Provider Response M1b is an independent provider-only offer inbox and
# accept/decline gate. It never inherits the Assignment flag above.
CARESLINK_PORTAL_REFERRAL_PROVIDER_RESPONSE_ENABLED=false
# Follow-up M1c independently authorizes an approved provider to read only its
# accepted referral detail and record one fixed-code outcome. It does not open
# response, history, scheduling, audit, document/export or free-text features.
CARESLINK_PORTAL_REFERRAL_FOLLOW_UP_ENABLED=false
CARESLINK_PORTAL_REFERRAL_EXPECTED_SUPABASE_REF=

# V1 NDIS canonical shadow slice. These are server-only and must stay unset in
# Production. All values are required together on an isolated Vercel Preview.
CARESLINK_V1_SHADOW_ENABLED=false
CARESLINK_V1_NDIS_DUAL_WRITE_ENABLED=false
CARESLINK_V1_NDIS_SHADOW_READ_ENABLED=false
CARESLINK_V1_SHADOW_EXPECTED_SUPABASE_REF=replace-with-isolated-branch-ref
CARESLINK_V1_NDIS_SHADOW_TIMEOUT_MS=1500
